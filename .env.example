LLM_API_KEY=

# OpenAI-compatible LLM configuration
LLM_MODEL=gpt-5.6
LLM_BASE_URL=
LLM_REASONING_EFFORT=

# OpenAI example:
# LLM_MODEL=gpt-5.6
# LLM_BASE_URL=
# LLM_REASONING_EFFORT=none

# DeepSeek example (uses the OpenAI-compatible API):
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_REASONING_EFFORT=

# Set false to use the LLM without web retrieval (non-real-time analysis).
WEB_SEARCH_ENABLED=true

# Supported values: brave, tavily
SEARCH_PROVIDER=brave
SEARCH_TIMEOUT_SECONDS=10

# Balanced research budget: controls latency, API use, and prompt size.
MAX_RESEARCH_TASKS=3
MAX_LLM_ITERATIONS=3
MAX_SEARCHES_PER_TASK=2
SEARCH_MAX_RESULTS=3
RAG_MAX_EVIDENCE=3
RAG_MAX_CONTEXT_CHARS=3600

# Brave Search API example:
BRAVE_SEARCH_API_KEY=
# Legacy Tavily adapter (leave blank when SEARCH_PROVIDER=brave):
TAVILY_API_KEY=

# Optional BGE reranker
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATE_K=5